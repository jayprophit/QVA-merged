# QVA Configuration
# Core system settings
QVA_MODE=development # development|testing|production
QVA_LOG_LEVEL=info # debug|info|warning|error
QVA_PORT=8000
QVA_HOST=0.0.0.0
QVA_DEBUG=true

# Database settings
DATABASE_URL=sqlite:///qva.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security settings
SECRET_KEY=your_super_secret_key_here
TOKEN_EXPIRY=86400 # 24 hours in seconds
ENABLE_2FA=false

# AI & ML settings
AI_MODEL_PATH=./models
OPENAI_API_KEY=your_openai_api_key
ENABLE_LOCAL_AI=true
AI_MODEL_TYPE=gpt-4

# Quantum settings
ENABLE_QUANTUM_SIMULATION=true
QUANTUM_CORES=4
QUANTUM_MEMORY=4096

# Blockchain settings
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NODE=http://localhost:8545
SMART_CONTRACT_ADDRESS=0x0

# Frontend settings
FRONTEND_URL=http://localhost:3000
ENABLE_3D_UI=true
ENABLE_VOICE_INTERFACE=true

# External services
ENABLE_EXTERNAL_API=false
API_RATE_LIMIT=100
